<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.workspaces-organizer-by-blueray453"
          path="/org/gnome/shell/extensions/workspaces-organizer-by-blueray453/">

    <!-- ===================== Appearance / sizing ===================== -->
    <key name="base-size" type="i">
      <default>40</default>
      <range min="16" max="96"/>
      <summary>UI base size</summary>
      <description>Every text and icon size scales from this value.</description>
    </key>
    <key name="glass-strength" type="i">
      <default>100</default>
      <range min="0" max="150"/>
      <summary>Surface transparency strength (%)</summary>
    </key>
    <key name="thumbnail-min-width" type="i">
      <default>60</default>
      <range min="20" max="200"/>
      <summary>Minimum workspace thumbnail width</summary>
    </key>

    <!-- ===================== Panel elements ===================== -->
    <key name="show-window-button" type="b">
      <default>true</default>
    </key>
    <key name="show-workspace-names" type="b">
      <default>true</default>
    </key>
    <key name="group-apps-always" type="b">
      <default>false</default>
    </key>

    <!-- ===================== Timing ===================== -->
    <key name="flyout-dwell-ms" type="i">
      <default>400</default>
      <range min="50" max="1500"/>
    </key>
    <key name="ext-ws-dwell-ms" type="i">
      <default>600</default>
      <range min="100" max="2000"/>
    </key>

    <!-- ===================== Accessibility ===================== -->
    <key name="reduce-motion" type="b">
      <default>false</default>
    </key>

    <!-- ===================== Panel ordering ===================== -->
    <key name="order-left" type="as">
      <default>['workspace-indicator']</default>
      <summary>Desired order of indicators in the left panel box</summary>
      <description>Roles listed here get repositioned; roles present in the box but not listed are left where they are.</description>
    </key>
    <key name="order-center" type="as">
      <default>[]</default>
      <summary>Desired order of indicators in the center panel box</summary>
    </key>
    <key name="order-right" type="as">
      <default>['ShowNetSpeedButton', 'printers', 'lockkeys@febueldo.test', 'color-picker@tuberry', 'clipboardIndicator', 'emoji-copy@felipeftn', 'athan@goodm4ven']</default>
      <summary>Desired order of indicators in the right panel box</summary>
    </key>

    <key name="discovered-left" type="as">
      <default>[]</default>
      <summary>Roles currently present in the left panel box (read-only snapshot)</summary>
    </key>
    <key name="discovered-center" type="as">
      <default>[]</default>
      <summary>Roles currently present in the center panel box (read-only snapshot)</summary>
    </key>
    <key name="discovered-right" type="as">
      <default>[]</default>
      <summary>Roles currently present in the right panel box (read-only snapshot)</summary>
    </key>

    <!-- ===================== Panel behaviour ===================== -->
    <key name="move-panel-to-bottom" type="b">
      <default>true</default>
      <summary>Move the top bar to the bottom of the screen</summary>
      <description>When off, the panel stays where the shell placed it. Ordering still applies.</description>
    </key>
    <key name="hide-activities" type="b">
      <default>true</default>
      <summary>Hide the Activities button</summary>
    </key>
    <key name="disable-panel-window-drag" type="b">
      <default>true</default>
      <summary>Stop pressing the panel from starting a window drag</summary>
    </key>
    <key name="date-menu-position" type="s">
      <choices>
        <choice value="stock"/>
        <choice value="left-first"/>
        <choice value="center-first"/>
        <choice value="right-first"/>
      </choices>
      <default>'right-first'</default>
      <summary>Where to move the date/clock menu</summary>
    </key>

  </schema>
</schemalist>
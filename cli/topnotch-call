#!/usr/bin/env gjs

// ===== FILE: ./cli/topnotch-call =====
//
// Method-call client for the TopNotchWorkspaces GNOME Shell extension.
// Interface is inferred from the method name — no `-i` flag.
//
// Methods that answer via signals (currently only `Show`) are rejected;
// use the `gdmenu` client for those.

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

const SPEC_CACHE_FILE = GLib.build_filenamev([
    GLib.get_home_dir(), '.cache', 'gnome-dbus-spec', 'topnotch.json'
]);

// Methods that answer via signals — cannot be served by a sync proxy.
const ASYNC_ONLY = new Set(['Show']);

function usage() {
    const prog = System.programInvocationName || 'topnotch-call';
    printerr(`Usage: ${prog} METHOD [PARAMETER...]`);
    printerr('  -h, --help             Show this');
    System.exit(1);
}

function loadSpec() {
    const file = Gio.File.new_for_path(SPEC_CACHE_FILE);
    if (!file.query_exists(null)) return null;
    try {
        const [ok, contents] = file.load_contents(null);
        if (!ok) return null;
        return JSON.parse(new TextDecoder().decode(contents));
    } catch (e) {
        return null;
    }
}

// Build method-name → ifaceData from every interface in the spec.
function buildMethodMap(spec) {
    const map = new Map();
    const ambiguous = new Set();
    for (const [, ifaceData] of Object.entries(spec.interfaces)) {
        let nodeInfo;
        try { nodeInfo = Gio.DBusNodeInfo.new_for_xml(ifaceData.xml); }
        catch (e) { continue; }
        if (!nodeInfo.interfaces?.length) continue;
        for (const m of nodeInfo.interfaces[0].methods) {
            if (map.has(m.name)) ambiguous.add(m.name);
            else map.set(m.name, ifaceData);
        }
    }
    return { map, ambiguous };
}

function getMethodSignature(xml, methodName) {
    let nodeInfo;
    try { nodeInfo = Gio.DBusNodeInfo.new_for_xml(xml); }
    catch (e) { return null; }
    if (!nodeInfo.interfaces?.length) return null;
    const methodInfo = nodeInfo.interfaces[0].methods.find(m => m.name === methodName);
    if (!methodInfo) return null;
    return methodInfo.in_args.map(a => a.signature);
}

function convertToJS(raw, expectedType) {
    const trimmed = raw.trim();
    switch (expectedType) {
        case 's': return trimmed.startsWith('"') && trimmed.endsWith('"')
            ? trimmed.slice(1, -1) : trimmed;
        case 'u': case 'i': case 'd': case 'x': case 't': return Number(trimmed);
        case 'b': return trimmed === 'true' || trimmed === '1';
        case 'as': return trimmed.split(',').map(s => s.trim().replace(/^"|"$/g, ''));
        default:
            printerr(`Unsupported D-Bus type "${expectedType}"`);
            System.exit(5);
    }
}

function main() {
    const args = ARGV.slice();
    if (args.length === 0) usage();
    if (args[0] === '-h' || args[0] === '--help') usage();

    const methodName = args[0];
    const params = args.slice(1);

    if (ASYNC_ONLY.has(methodName)) {
        printerr(`"${methodName}" is signal-based — use gdmenu`);
        System.exit(4);
    }

    const spec = loadSpec();
    if (!spec) {
        printerr('topnotch-call: TopNotchWorkspaces extension is not enabled');
        System.exit(2);
    }

    const { map, ambiguous } = buildMethodMap(spec);
    if (ambiguous.has(methodName)) {
        printerr(`Method "${methodName}" is defined on multiple interfaces`);
        System.exit(4);
    }
    const ifaceData = map.get(methodName);
    if (!ifaceData) {
        printerr(`Method "${methodName}" not found`);
        System.exit(4);
    }

    let proxy;
    try {
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(ifaceData.xml);
        proxy = new ProxyClass(Gio.DBus.session, spec.bus_name, ifaceData.object_path);
    } catch (e) {
        printerr(`topnotch-call: could not build proxy: ${e.message}`);
        System.exit(2);
    }

    const syncMethodName = methodName + 'Sync';
    if (typeof proxy[syncMethodName] !== 'function') {
        printerr(`Method "${methodName}" not found`);
        System.exit(4);
    }

    const argTypes = getMethodSignature(ifaceData.xml, methodName);
    if (!argTypes) {
        printerr(`Could not parse signature for "${methodName}"`);
        System.exit(4);
    }

    if (params.length !== argTypes.length) {
        printerr(`Expected ${argTypes.length} arguments, but got ${params.length}`);
        System.exit(4);
    }

    const jsArgs = params.map((p, i) => convertToJS(p, argTypes[i]));

    try {
        const result = proxy[syncMethodName](...jsArgs);
        if (result && result.length > 0 && result[0] !== undefined)
            print(typeof result[0] === 'string' ? result[0] : String(result[0]));
        System.exit(0);
    } catch (e) {
        if (e instanceof Gio.DBusError) Gio.DBusError.strip_remote_error(e);
        printerr(`Method call failed: ${e.message}`);
        System.exit(5);
    }
}

main();
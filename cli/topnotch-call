#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

const BUS_NAME = 'io.github.blueray453.TopNotchWorkspaces';
const OBJECT_PATH = '/io/github/blueray453/TopNotchWorkspaces/Overlay';

// Interface spec — mirrors lib/dbusService.js MR_DBUS_IFACE but omits
//   • Show               (needs a pre-subscribed Selected/Cancelled channel)
//   • Selected, Cancelled (signals)
// The excluded picker flow is served by the separate `gdmenu` client.
const IFACE_XML = `
<node>
   <interface name="io.github.blueray453.TopNotchWorkspaces.Overlay">
      <method name="ShowAllWindows"/>
      <method name="ShowAllApps"/>
      <method name="ShowWorkspaceWindows">
         <arg type="u" direction="in" name="workspace_num"/>
      </method>
      <method name="ToggleAllWindows"/>
      <method name="ToggleAllApps"/>
      <method name="ToggleWorkspaceWindows">
         <arg type="u" direction="in" name="workspace_num"/>
      </method>
      <method name="CloseOverlay"/>
      <method name="CycleWindowsOnWorkspace">
         <arg type="u" direction="in" name="workspace_num"/>
      </method>
      <method name="ToggleGroupFlyout">
         <arg type="u" direction="in" name="workspace_num"/>
         <arg type="s" direction="in" name="wm_class"/>
         <arg type="b" direction="out" name="opened"/>
      </method>
      <method name="CloseFlyout">
         <arg type="b" direction="out" name="was_open"/>
      </method>
      <method name="ToggleSelectedWindow"/>
      <method name="CloseNotSelectedWindows"/>
   </interface>
</node>`;

function usage() {
    const prog = System.programInvocationName || 'topnotch-call';
    printerr(`Usage: ${prog} METHOD [PARAMETER...]`);
    printerr('');
    printerr('Methods:');
    printerr('  ShowAllWindows');
    printerr('  ShowAllApps');
    printerr('  ShowWorkspaceWindows <workspace_num>');
    printerr('  ToggleAllWindows');
    printerr('  ToggleAllApps');
    printerr('  ToggleWorkspaceWindows <workspace_num>');
    printerr('  CloseOverlay');
    printerr('  CycleWindowsOnWorkspace <workspace_num>');
    printerr('  ToggleGroupFlyout <workspace_num> <wm_class>');
    printerr('  CloseFlyout');
    printerr('  ToggleSelectedWindow');
    printerr('  CloseNotSelectedWindows');
    printerr('');
    printerr('  -h, --help             Show this');
    System.exit(1);
}

// Parse the in-args of `methodName` from the embedded spec. Uses GLib's
// XML parser so the signature is derived from the same document the proxy
// is built from — no drift between usage and dispatch.
function getMethodSignature(methodName) {
    let nodeInfo;
    try {
        nodeInfo = Gio.DBusNodeInfo.new_for_xml(IFACE_XML);
    } catch (e) {
        return null;
    }
    if (!nodeInfo.interfaces || nodeInfo.interfaces.length === 0) return null;
    const ifaceInfo = nodeInfo.interfaces[0];
    const methodInfo = ifaceInfo.methods.find(m => m.name === methodName);
    if (!methodInfo) return null;
    return methodInfo.in_args.map(arg => arg.signature);
}

function convertToJS(raw, expectedType) {
    const trimmed = raw.trim();
    switch (expectedType) {
        case 's': return trimmed.startsWith('"') && trimmed.endsWith('"') ? trimmed.slice(1, -1) : trimmed;
        case 'u': case 'i': case 'd': case 'x': case 't': return Number(trimmed);
        case 'b': return trimmed === 'true' || trimmed === '1';
        case 'as': return trimmed.split(',').map(s => s.trim().replace(/^"|"$/g, ''));
        default:
            printerr(`Unsupported D-Bus type "${expectedType}"`);
            System.exit(5);
    }
}

function main() {
    const args = ARGV.slice();
    if (args.length === 0) usage();
    if (args[0] === '-h' || args[0] === '--help') usage();

    const methodName = args[0];
    const params = args.slice(1);

    // Build the proxy. A missing bus name / object path surfaces here as a
    // proxy-construction failure, which we report with exit 2 like the
    // reference script.
    let proxy;
    try {
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(IFACE_XML);
        proxy = new ProxyClass(Gio.DBus.session, BUS_NAME, OBJECT_PATH);
    } catch (e) {
        printerr(`topnotch-call: could not build proxy: ${e.message}`);
        System.exit(2);
    }

    const syncMethodName = methodName + 'Sync';
    if (typeof proxy[syncMethodName] !== 'function') {
        printerr(`Method "${methodName}" not found`);
        System.exit(4);
    }

    const argTypes = getMethodSignature(methodName);
    if (!argTypes) {
        printerr(`Could not parse signature for "${methodName}"`);
        System.exit(4);
    }

    if (params.length !== argTypes.length) {
        printerr(`Expected ${argTypes.length} arguments, but got ${params.length}`);
        System.exit(4);
    }

    const jsArgs = params.map((p, i) => convertToJS(p, argTypes[i]));

    try {
        const result = proxy[syncMethodName](...jsArgs);
        // Void methods yield []; methods with an `out b` yield [true|false].
        if (result && result.length > 0 && result[0] !== undefined)
            print(typeof result[0] === 'string' ? result[0] : String(result[0]));
        System.exit(0);
    } catch (e) {
        if (e instanceof Gio.DBusError) Gio.DBusError.strip_remote_error(e);
        printerr(`Method call failed: ${e.message}`);
        System.exit(5);
    }
}

main();
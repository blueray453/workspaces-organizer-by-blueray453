#!/usr/bin/env gjs

imports.gi.versions.Gio = '2.0';
const { Gio, GLib } = imports.gi;
const System = imports.system;

let GioUnix;
try { GioUnix = imports.gi.GioUnix; } catch (e) { GioUnix = null; }

const BUS_NAME = 'io.github.blueray453.TopNotchWorkspaces';
const BUS_PATH = '/io/github/blueray453/TopNotchWorkspaces/Overlay';
const ARGS_MARKER = 'args::';

const IFACE_XML = `
<node>
   <interface name="io.github.blueray453.TopNotchWorkspaces.Overlay">
      <method name="ShowWithOptions">
         <arg type="as"         direction="in" name="items"/>
         <arg type="b"          direction="in" name="multi"/>
         <arg type="s"          direction="in" name="hint"/>
         <arg type="a(ssa(ss))" direction="in" name="controls"/>
      </method>
      <signal name="Selected"><arg type="as" name="items"/></signal>
      <signal name="Cancelled"/>
   </interface>
</node>`;

const HELP_TEXT = `Usage: gdmenu [OPTIONS]

Reads items from stdin (one per line), opens the TopNotch picker overlay,
and prints the result as plain lines:

  <selected value>...     in original input order
  args::                  reserved marker, always printed
  <argument line>...      one per enabled control argument

Options:
  --multi                    Multi-select. Click, Tab, Ctrl+Space or
                             Shift+Enter toggle a row; Enter (or the
                             Confirm button) prints every checked row, or
                             the cursor row if none are checked.
  --hint TEXT                Custom hint text shown in the search entry.
  --toggle LABEL ARG         Add an on/off switch (default off). When on,
                             ARG is printed after args::.
  --choice LABEL OPT OPT...  Add a segmented selector. Each OPT is
                             'Label|arg' (split on the first '|'). The
                             first option is the default; an empty arg
                             prints nothing. Needs at least 2 options.
  --output records           Line-oriented output (the only format).
  -h, --help                 Show this help and exit.

Controls appear in command-line order. The line 'args::' is reserved and
cannot be an input item.

Exit codes:
  0   selected      — stdout contains the records
  1   cancelled     — Esc, click outside the panel, empty stdin, bad usage
  2   D-Bus error   — extension not enabled, or the call failed

Requires the TopNotchWorkspaces GNOME Shell extension. The extension
installs this script as a symlink at ~/.local/bin/gdmenu on enable().`;

function usage({ exitCode = 1, toStderr = true } = {}) {
    if (toStderr) printerr(HELP_TEXT);
    else print(HELP_TEXT);
    System.exit(exitCode);
}

function fail(msg) {
    printerr(`gdmenu: ${msg}`);
    usage();
}

function readStdinLines() {
    const unixStream = GioUnix
        ? new GioUnix.InputStream({ fd: 0, close_fd: false })
        : new Gio.UnixInputStream({ fd: 0, close_fd: false });
    const dataStream = new Gio.DataInputStream({ base_stream: unixStream });
    const lines = [];
    while (true) {
        const [line] = dataStream.read_line_utf8(null);
        if (line === null) break;
        if (line.length > 0) lines.push(line);
    }
    return lines;
}

function parseOption(raw) {
    const d = raw.indexOf('|');
    return d < 0
        ? [raw.trim(), '']
        : [raw.slice(0, d).trim(), raw.slice(d + 1).trim()];
}

function main() {
    let multi = false;
    let hint = '';
    const controls = [];   // [kind, label, [[optLabel, optArg], ...]]

    for (let i = 0; i < ARGV.length; i++) {
        const a = ARGV[i];
        if (a === '-h' || a === '--help') {
            usage({ exitCode: 0, toStderr: false });
        } else if (a === '--multi') {
            multi = true;
        } else if (a === '--hint') {
            if (i + 1 < ARGV.length) hint = ARGV[++i];
            else fail('--hint requires an argument');
        } else if (a === '--toggle') {
            if (i + 2 >= ARGV.length) fail('--toggle requires LABEL and ARG');
            const label = ARGV[++i];
            const arg = ARGV[++i].trim();
            if (!arg) fail('--toggle ARG must not be empty');
            controls.push(['toggle', label, [['', arg]]]);
        } else if (a === '--choice') {
            if (i + 1 >= ARGV.length) fail('--choice requires LABEL and options');
            const label = ARGV[++i];
            const opts = [];
            while (i + 1 < ARGV.length && !ARGV[i + 1].startsWith('--'))
                opts.push(parseOption(ARGV[++i]));
            if (opts.length < 2) fail('--choice needs at least 2 options');
            controls.push(['choice', label, opts]);
        } else if (a === '--output') {
            if (i + 1 >= ARGV.length) fail('--output requires an argument');
            if (ARGV[++i] !== 'records') fail('--output: only "records" is supported');
        } else {
            fail(`unknown option: ${a}`);
        }
    }

    const lines = readStdinLines();
    if (lines.length === 0) {
        printerr('gdmenu: no input provided on stdin');
        System.exit(1);
    }
    if (lines.includes(ARGS_MARKER)) {
        printerr(`gdmenu: "${ARGS_MARKER}" is reserved and cannot be an item`);
        System.exit(1);
    }

    let proxy;
    try {
        const ProxyClass = Gio.DBusProxy.makeProxyWrapper(IFACE_XML);
        proxy = new ProxyClass(Gio.DBus.session, BUS_NAME, BUS_PATH);
    } catch (e) {
        printerr(`gdmenu: cannot reach TopNotch: ${e.message}`);
        System.exit(2);
    }

    const loop = GLib.MainLoop.new(null, false);
    let result = null;

    const selId = proxy.connectSignal('Selected',
        (_p, _s, args) => { result = args[0]; loop.quit(); });
    const canId = proxy.connectSignal('Cancelled',
        () => { result = null; loop.quit(); });

    try {
        proxy.ShowWithOptionsSync(lines, multi, hint, controls);
    } catch (e) {
        if (e instanceof Gio.DBusError) Gio.DBusError.strip_remote_error(e);
        printerr(`gdmenu: D-Bus call failed: ${e.message}`);
        System.exit(2);
    }

    loop.run();
    proxy.disconnectSignal(selId);
    proxy.disconnectSignal(canId);

    if (result && result.length > 0) {
        for (const item of result) print(item);
        System.exit(0);
    }
    System.exit(1);
}

main();